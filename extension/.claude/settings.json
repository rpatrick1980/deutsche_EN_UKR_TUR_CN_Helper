{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(yarn:*)",
      "Bash(npx vite build:*)",
      "Bash(npx vite:*)",
      "Bash(npx tsc:*)",
      "Bash(npx esbuild:*)",
      "Bash(node:*)",
      "Bash(python3 build_assets.py)",
      "Bash(python3 capture_live.py)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(zip:*)",
      "Bash(unzip -l:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(python3 -m playwright install:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*secret*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
