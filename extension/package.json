{
  "name": "german-reading-helper",
  "version": "1.0.0",
  "description": "Chrome extension that helps adult learners read German webpages: translate and explain grammar in a right-side panel.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "test": "npx esbuild test/logic.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/grh.test.cjs && node /tmp/grh.test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
